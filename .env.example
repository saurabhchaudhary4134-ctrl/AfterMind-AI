# AfterMind AI — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (local dev) or set these in your PaaS dashboard.
# NEVER commit a real .env file — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application environment ──────────────────────────────────────────────────
# Values: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev — SQLite (no install required)
DATABASE_URL=sqlite:///./aftermind_dev.db

# Neon PostgreSQL (production) — copy the "Pooled connection" string from
# your Neon project dashboard, then replace "postgresql://" with
# "postgresql+psycopg2://" so SQLAlchemy uses the psycopg2 driver:
#
#   DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# ⚠️  Neon free tier uses pooled connections — add ?sslmode=require to the URL.

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Only needed when SIMULATION_SYNC=false (i.e. using Celery workers).
# On Render free tier, leave SIMULATION_SYNC=true and skip these.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a secure key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Render can generate this for you automatically (generateValue: true in render.yaml).
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev — allow the Next.js dev server
CORS_ORIGINS=http://localhost:3000
#
# Production — set to your Vercel deployment URL (comma-separate multiple):
#   CORS_ORIGINS=https://aftermind-ai.vercel.app
#   CORS_ORIGINS=https://aftermind-ai.vercel.app,https://www.yourdomain.com
#
# ⚠️  Never use CORS_ORIGINS=* in production.

# ── Simulation ────────────────────────────────────────────────────────────────
# true  → simulations run synchronously in the request (no Redis/Celery needed)
# false → simulations are queued via Celery (requires Redis)
# Render free tier: keep true
SIMULATION_SYNC=true
MAX_ITERATIONS=100000
MAX_VARIABLES=50
MAX_FORMULAS=50
MAX_BODY_SIZE_BYTES=1048576

# ── LLM Integration (optional) ───────────────────────────────────────────────
# Leave LLM_PROVIDER empty to disable LLM features.
# Core Monte Carlo simulation works fully without any LLM provider.
LLM_PROVIDER=
# LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2000

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Baked into the browser bundle at build time — must be set BEFORE npm run build.
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Vercel: set this in the Vercel dashboard under Project → Settings → Environment Variables
#   NEXT_PUBLIC_API_URL=https://aftermind-api.onrender.com/api/v1

# ── Payments (optional — requires explicit authorization) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
